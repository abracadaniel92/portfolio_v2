// Cloudflare Workers static assets. Committed so `wrangler deploy` never runs its
// auto-setup, which rewrites vite.config and picks SPA mode (a soft 404 for
// every miss). No Worker script: just dist/.
{
  "name": "my-portfolio",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    // Misses get dist/404.html with a real 404 status, never the homepage.
    "not_found_handling": "404-page"
  }
}
